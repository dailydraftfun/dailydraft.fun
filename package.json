{
  "name": "@dailydraft/monorepo",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@dailydraft/api",
    "dev:web": "turbo run dev --filter=@dailydraft/web",
    "dev:app": "turbo run dev --filter=@dailydraft/app",
    "dev:docs": "turbo run dev --filter=@dailydraft/docs",
    "dev:mcp": "turbo run dev --filter=@dailydraft/mcp",
    "deploy:api:migrate": "bun --filter @dailydraft/db db:deploy",
    "smoke:devnet": "bun run scripts/devnet-smoke.ts",
    "rgs:simulate": "bun scripts/rgs-simulation.ts",
    "rgs:verify": "bun scripts/rgs-simulation.ts --check",
    "ci:readiness": "bun scripts/ci-readiness.ts",
    "conformance:api-production": "bun scripts/api-production-conformance.ts --artifact apps/api/dist --report artifacts/api-production-conformance.json",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage-gate": "bunx biome check scripts/changed-coverage package.json && tsc --noEmit -p scripts/changed-coverage/tsconfig.json && bun test scripts/changed-coverage/changed-coverage.test.ts",
    "coverage:changed": "bun run scripts/changed-coverage/run.ts",
    "lint:fix": "bunx biome check --write .",
    "lint:design": "bunx @google/design.md lint DESIGN.md",
    "design:export": "bunx @google/design.md export --format tailwind DESIGN.md",
    "format:check": "bunx biome check . --linter-enabled=false --assist-enabled=false --files-ignore-unknown=true",
    "postinstall": "test -d node_modules/@shipshitdev/ui || (src=$(ls -d node_modules/.bun/@shipshitdev+ui@*/node_modules/@shipshitdev/ui 2>/dev/null | head -1) && [ -n \"$src\" ] && mkdir -p node_modules/@shipshitdev && ln -s \"$(cd \"$src\" && pwd)\" node_modules/@shipshitdev/ui) || true",
    "deps:update": "bun update --latest",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@google/design.md": "0.1.1",
    "@solana/web3.js": "1.98.4",
    "@types/bun": "1.3.8",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "25.6.0",
    "istanbul-lib-instrument": "^6.0.3",
    "turbo": "2.9.6",
    "typescript": "6.0.3"
  },
  "patchedDependencies": {
    "nextra-theme-docs@4.6.1": "patches/nextra-theme-docs@4.6.1.patch"
  }
}
