generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum DuelMode {
  DIRECT
  OPEN
  HOUSE
}

enum DuelStatus {
  WAITING
  MATCHED
  COMMITTING
  FUNDED
  OPENING
  AWAITING_ASSETS
  SETTLING
  SETTLED
  CANCELLING
  CANCELLED
  REFUNDING
  REFUNDED
  FAILED
}

enum SolanaNetwork {
  DEVNET
}

enum ProviderMode {
  MOCK
  OPENPACKSDUEL_DEVNET
  COLLECTOR_CRYPT_SANDBOX
}

enum DuelSide {
  CREATOR
  OPPONENT
}

enum DuelTransactionAction {
  FUND
  CANCEL
  REFUND
  OPEN_PACK
  COMMIT_RESULT
  SETTLE
}

enum DuelTransactionStatus {
  PREPARED
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED
  EXPIRED
}

enum ProductEventName {
  LOBBY_VIEWED
  TIER_SELECTED
  WALLET_CONNECTED
  WALLET_AUTHENTICATED
  DUEL_CREATED
  DUEL_MATCHED
  DUEL_FUNDED
  PACK_REVEAL_STARTED
  PACK_REVEALED
  DUEL_SHARED
  DUEL_REMATCHED
  DUEL_CANCELLED
  DUEL_REFUNDED
  DUEL_SETTLED
  SETTLEMENT_FAILED
  PROVIDER_ERROR
  SOLANA_RPC_ERROR
  UI_ERROR
  MATCHMAKING_WAIT_STARTED
  MATCHMAKING_MATCHED
  MATCHMAKING_ABANDONED
  MATCHMAKING_COMMITMENT_FAILED
  HOUSE_FALLBACK_SELECTED
}

enum ProductEventSource {
  CLIENT
  SERVER
}

enum OperatorAction {
  EMERGENCY_PAUSE
  EMERGENCY_RESUME
}

enum OperatorActorClass {
  INTEGRATION_KEY
}

enum OperatorReasonCode {
  MAINTENANCE
  PROVIDER_DEGRADED
  RPC_DEGRADED
  TREASURY_LIMIT
  SECURITY_INCIDENT
  MANUAL_REVIEW
}

enum MatchmakingTicketRole {
  CREATOR
  OPPONENT
}

enum MatchmakingTicketStatus {
  SEARCHING
  MATCHED
}

enum HouseTreasuryReservationStatus {
  RESERVED
  FUNDED
  SETTLEMENT_PENDING
  RECOVERY_REQUIRED
  RELEASED
  SETTLED
}

enum HouseTreasuryLedgerType {
  RESERVATION_CREATED
  RESERVATION_RELEASED
  HOUSE_FUNDING_COMMITTED
  PLAYER_WIN_LOSS
  HOUSE_PACK_COST
  HOUSE_WIN_INVENTORY
  INVENTORY_DISPOSITION_SET
  INVENTORY_DISPOSED
  RECONCILIATION_ALERT
}

enum HouseInventoryDisposition {
  HOLD
  BUYBACK
  LIST
  PROMOTION
  MANUAL_REVIEW
}

enum HouseInventoryStatus {
  HELD
  LISTED
  DISPOSED
  RECONCILIATION_REQUIRED
}

enum HouseInventoryListingState {
  UNLISTED
  LISTED
  SOLD
  DELISTED
}

enum FlipInventoryExclusionReason {
  EXPLICIT_EXCLUSION
  COLLECTION_NOT_ALLOWED
  GRADER_NOT_ALLOWED
  INVENTORY_STALE
  INVENTORY_FROM_FUTURE
  LIQUIDITY_BELOW_MINIMUM
  VALUE_UNAVAILABLE
  VALUE_STALE
  VALUE_FROM_FUTURE
  VALUE_BELOW_MINIMUM
  VALUE_ABOVE_MAXIMUM
  MAXIMUM_ITEM_COUNT
  MAXIMUM_EXPOSURE
}

model Duel {
  id                  String                     @id
  mode                DuelMode
  status              DuelStatus
  network             SolanaNetwork              @default(DEVNET)
  providerMode        ProviderMode               @default(MOCK)
  creatorWallet       String
  opponentWallet      String?
  opponentJoinedAt    DateTime?
  houseOpponent       Boolean                    @default(false)
  winnerWallet        String?
  escrowAddress       String?
  packId              String
  packName            String
  packProvider        String
  providerPackId      String?
  stakeAmount         String
  stakeCurrency       String                     @default("USDC")
  stakeDecimals       Int                        @default(6)
  valuationPolicyHash String?
  expiresAt           DateTime
  cancellationReason  String?
  version             Int                        @default(1)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  matchedAt           DateTime?
  fundedAt            DateTime?
  settledAt           DateTime?
  resultHash          String?
  resultReadyAt       DateTime?
  commitmentExpiresAt DateTime?
  events              DuelEvent[]
  transactions        DuelTransaction[]
  packOutcomes        DuelPackOutcome[]
  matchmakingTickets  MatchmakingTicket[]
  houseReservation    HouseTreasuryReservation?
  houseInventory      HouseInventoryAsset[]
  houseLedgerEntries  HouseTreasuryLedgerEntry[]
  devnetPackSnapshots DevnetPackSnapshot[]

  @@index([status, expiresAt])
  @@index([mode, status, packId, createdAt])
  @@index([creatorWallet, createdAt])
  @@index([opponentWallet, createdAt])
  @@index([status, settledAt, id])
  @@index([winnerWallet, createdAt])
}

model DevnetPackSnapshot {
  providerReference     String    @id
  duelId                String
  side                  DuelSide
  providerPackId        String
  pokemonCardId         String
  displayName           String
  imageUrl              String
  insuredValueAmount    String
  priceVariant          String
  priceUpdatedAt        String
  sourceTimestamp       DateTime
  depositLeaseOwner     String?
  depositLeaseExpiresAt DateTime?
  depositSignature      String?
  assetReference        String?
  openedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  duel                  Duel      @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, side])
  @@index([pokemonCardId, createdAt])
}

model MatchmakingTicket {
  id                  String                  @id
  wallet              String                  @unique
  duelId              String
  role                MatchmakingTicketRole
  status              MatchmakingTicketStatus
  queueKey            String
  packId              String
  tier                Int
  valuationPolicyHash String
  providerMode        ProviderMode
  regionSegment       String
  riskSegment         String
  commitmentExpiresAt DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  duel                Duel                    @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, role])
  @@index([queueKey, status, createdAt])
  @@index([commitmentExpiresAt, status])
}

model MatchmakingBehavior {
  wallet                 String    @id
  failedCommitments      Int       @default(0)
  failureWindowStartedAt DateTime
  blockedUntil           DateTime?
  updatedAt              DateTime  @updatedAt

  @@index([blockedUntil])
}

model DuelPackOutcome {
  id                       String               @id
  duelId                   String
  side                     DuelSide
  provider                 String
  providerReference        String
  assetReference           String
  displayName              String
  imageUrl                 String?
  valuationSourceReference String?
  insuredValueAmount       String
  insuredValueCurrency     String               @default("USDC")
  insuredValueDecimals     Int                  @default(6)
  sourceTimestamp          DateTime?
  poolVersion              String?
  valuationPolicyHash      String
  resultHash               String
  isMock                   Boolean
  openedAt                 DateTime
  createdAt                DateTime             @default(now())
  duel                     Duel                 @relation(fields: [duelId], references: [id], onDelete: Cascade)
  houseInventoryAsset      HouseInventoryAsset?

  @@unique([duelId, side])
  @@unique([provider, providerReference])
  @@index([duelId, openedAt])
}

model DuelEvent {
  id          String      @id
  duelId      String
  sequence    Int
  type        String
  actorWallet String?
  fromStatus  DuelStatus?
  toStatus    DuelStatus?
  data        Json?
  createdAt   DateTime    @default(now())
  duel        Duel        @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, sequence])
  @@index([duelId, createdAt])
}

model IdempotencyRecord {
  id          String   @id
  scope       String
  key         String
  requestHash String
  resourceId  String
  statusCode  Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

model DuelTransaction {
  id                              String                @id
  duelId                          String
  action                          DuelTransactionAction
  status                          DuelTransactionStatus @default(PREPARED)
  network                         SolanaNetwork         @default(DEVNET)
  wallet                          String
  signature                       String?               @unique
  idempotencyKey                  String?               @unique
  submissionIdempotencyKey        String?               @unique
  serializedTransaction           String?
  recentBlockhash                 String?
  lastValidBlockHeight            BigInt?
  expectedSigner                  String?
  expectedProgramId               String?
  expectedMessageHash             String?
  expectedAccounts                Json?
  expectedInstructionDataHash     String?
  expectedInstructionAccounts     Json?
  allowMultipleInstructionMatches Boolean               @default(false)
  expectedFromStatus              DuelStatus?
  expectedToStatus                DuelStatus?
  providerReference               String?
  errorCode                       String?
  errorMessage                    String?
  metadata                        Json?
  confirmationStatus              String?
  checkAttempts                   Int                   @default(0)
  lastCheckedAt                   DateTime?
  nextCheckAt                     DateTime?
  stuckAt                         DateTime?
  submittedAt                     DateTime?
  recoveredAt                     DateTime?
  lastRecoveryCheckedAt           DateTime?
  lastRecoveryCheckedBlockHeight  BigInt?
  nextRecoveryCheckAt             DateTime?
  recoveryCheckAttempts           Int                   @default(0)
  recoveryCandidateAt             DateTime?
  recoveryCandidateSignature      String?
  recoveryAlertCode               String?
  confirmedAt                     DateTime?
  finalizedAt                     DateTime?
  expiresAt                       DateTime?
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
  duel                            Duel                  @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@index([duelId, createdAt])
  @@index([duelId, wallet, action])
  @@index([status, updatedAt])
  @@index([status, nextCheckAt])
  @@index([status, nextRecoveryCheckAt, createdAt])
  @@index([recoveryCandidateAt])
}

model WalletAuthChallenge {
  id         String    @id
  wallet     String
  nonceHash  String    @unique
  domain     String
  uri        String
  chain      String
  message    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([wallet, expiresAt])
  @@index([wallet, createdAt])
  @@index([expiresAt, consumedAt])
}

model WalletSession {
  id         String    @id
  wallet     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  @@index([wallet, expiresAt])
  @@index([expiresAt, revokedAt])
}

model ProductEvent {
  id        String             @id
  name      ProductEventName
  source    ProductEventSource
  sessionId String?
  duelId    String?
  status    DuelStatus?
  tier      Int?
  mode      DuelMode?
  createdAt DateTime           @default(now())

  @@index([createdAt, name])
  @@index([sessionId, createdAt])
  @@index([duelId, createdAt])
}

/// Immutable decision evidence recorded before an exposure-creating API operation.
model RealValuePolicyDecision {
  id            String   @id
  capability    String
  runtimeMode   String
  schemaVersion String
  policyVersion String
  policyHash    String
  allowed       Boolean
  denialReason  String?
  evidence      Json
  evaluatedAt   DateTime
  createdAt     DateTime @default(now())

  @@index([capability, evaluatedAt])
  @@index([allowed, evaluatedAt])
  @@index([policyVersion, evaluatedAt])
}

model RuntimeControl {
  key        String              @id
  paused     Boolean             @default(false)
  reasonCode OperatorReasonCode?
  actorClass OperatorActorClass  @default(INTEGRATION_KEY)
  actorLabel String              @default("integration-key")
  version    Int                 @default(1)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model OperatorAuditEvent {
  id             String             @id
  action         OperatorAction
  actorClass     OperatorActorClass
  actorLabel     String
  reasonCode     OperatorReasonCode
  previousPaused Boolean
  nextPaused     Boolean
  createdAt      DateTime           @default(now())

  @@index([createdAt, id])
}

/// One mutable, finalized balance snapshot per network/wallet/mint/token account policy.
/// The service uses the fixed `solana-devnet-usdc` id for the current devnet policy.
model HouseTreasurySnapshot {
  id              String        @id
  network         SolanaNetwork @default(DEVNET)
  wallet          String
  tokenAccount    String
  mint            String
  balanceAmount   String
  balanceDecimals Int
  delegate        String
  delegatedAmount String
  verifiedAt      DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([network, wallet, mint, tokenAccount])
}

/// Current admission state for each configured house tier. The reservation engine remains the
/// enforcement point; this row makes its latest fail-closed decision and recovery boundary
/// observable without affecting already-funded lifecycle processing.
model HouseTierAdmissionState {
  tier             Int      @id
  disabled         Boolean  @default(false)
  reason           String?
  reenableBoundary String?
  evaluatedAt      DateTime
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HouseTreasuryReservation {
  id               String                         @id
  duelId           String                         @unique
  playerWallet     String
  tier             Int
  amount           String
  currency         String                         @default("USDC")
  decimals         Int                            @default(6)
  status           HouseTreasuryReservationStatus @default(RESERVED)
  reservedAt       DateTime                       @default(now())
  fundedAt         DateTime?
  releasedAt       DateTime?
  settledAt        DateTime?
  lastReconciledAt DateTime?
  version          Int                            @default(1)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  duel             Duel                           @relation(fields: [duelId], references: [id], onDelete: Restrict)
  ledgerEntries    HouseTreasuryLedgerEntry[]

  @@index([status, tier, reservedAt])
  @@index([status, lastReconciledAt, id])
  @@index([playerWallet, status])
}

model HouseInventoryAsset {
  id                       String                     @id
  duelId                   String
  outcomeId                String                     @unique
  assetReference           String                     @unique
  displayName              String
  acquisitionValueAmount   String
  acquisitionValueCurrency String                     @default("USDC")
  acquisitionValueDecimals Int                        @default(6)
  insuredValueAmount       String
  insuredValueCurrency     String                     @default("USDC")
  insuredValueDecimals     Int                        @default(6)
  listingValueAmount       String?
  listingValueCurrency     String?
  listingValueDecimals     Int?
  buybackValueAmount       String?
  buybackValueCurrency     String?
  buybackValueDecimals     Int?
  displayedValueAmount     String?
  displayedValueCurrency   String?
  displayedValueDecimals   Int?
  buybackEligible          Boolean                    @default(false)
  buybackExpiresAt         DateTime?
  listingState             HouseInventoryListingState @default(UNLISTED)
  custodyWallet            String
  disposition              HouseInventoryDisposition  @default(MANUAL_REVIEW)
  status                   HouseInventoryStatus       @default(HELD)
  realizedAmount           String?
  realizedCurrency         String?
  realizedDecimals         Int?
  disposedAt               DateTime?
  lastReconciledAt         DateTime?
  reconciliationError      String?
  version                  Int                        @default(1)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  duel                     Duel                       @relation(fields: [duelId], references: [id], onDelete: Restrict)
  outcome                  DuelPackOutcome            @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  ledgerEntries            HouseTreasuryLedgerEntry[]

  @@index([status, disposition, createdAt])
  @@index([duelId, createdAt])
  @@index([custodyWallet, status])
}

model HouseTreasuryLedgerEntry {
  id             String                    @id
  idempotencyKey String                    @unique
  duelId         String?
  reservationId  String?
  inventoryId    String?
  type           HouseTreasuryLedgerType
  amount         String
  currency       String                    @default("USDC")
  decimals       Int                       @default(6)
  metadata       Json?
  createdAt      DateTime                  @default(now())
  duel           Duel?                     @relation(fields: [duelId], references: [id], onDelete: Restrict)
  reservation    HouseTreasuryReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  inventory      HouseInventoryAsset?      @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([createdAt, type])
  @@index([duelId, createdAt])
  @@index([inventoryId, createdAt])
}

/// Immutable, fixture-backed eligibility evidence for one reviewed Flip pool.
/// A new content hash creates a new revision; existing revisions are append-only.
model FlipInventorySnapshot {
  id                          String                       @id
  poolKey                     String
  revision                    Int
  schemaVersion               String
  policyVersion               String
  provider                    String
  policyHash                  String
  contentHash                 String
  policy                      Json
  stakeAmount                 String
  stakeCurrency               String                       @default("USDC")
  stakeDecimals               Int                          @default(6)
  minimumValueAmount          String
  maximumValueAmount          String
  minimumLiquidityBasisPoints Int
  minimumEligibleItems        Int
  maximumEligibleItems        Int
  maximumExposureAmount       String
  maximumSourceAgeMs          Int
  maximumFutureSkewMs         Int
  eligibleCount               Int
  excludedCount               Int
  eligibleValueAmount         String
  evaluatedAt                 DateTime
  sealedAt                    DateTime?
  createdAt                   DateTime                     @default(now())
  entries                     FlipInventorySnapshotEntry[]

  @@unique([poolKey, revision])
  @@unique([poolKey, contentHash])
  @@index([poolKey, createdAt])
}

/// One canonical provider candidate and the exact inclusion or exclusion decision.
/// Provider evidence and each value type remain distinct from the normalized pool value.
model FlipInventorySnapshotEntry {
  id                                     String                         @id
  snapshotId                             String
  ordinal                                Int
  eligible                               Boolean
  exclusionReasons                       FlipInventoryExclusionReason[]
  providerAssetReference                 String
  providerListingReference               String
  providerCollectionReference            String
  providerGraderReference                String
  normalizedCollection                   String
  normalizedGrader                       String
  liquidityBasisPoints                   Int
  inventorySourceTimestamp               DateTime
  listingValueAmount                     String?
  listingValueCurrency                   String?
  listingValueDecimals                   Int?
  listingValueProviderReference          String?
  listingValueSourceTimestamp            DateTime?
  insuredValueAmount                     String?
  insuredValueCurrency                   String?
  insuredValueDecimals                   Int?
  insuredValueProviderReference          String?
  insuredValueSourceTimestamp            DateTime?
  buybackValueAmount                     String?
  buybackValueCurrency                   String?
  buybackValueDecimals                   Int?
  buybackValueProviderReference          String?
  buybackValueSourceTimestamp            DateTime?
  displayedValueAmount                   String?
  displayedValueCurrency                 String?
  displayedValueDecimals                 Int?
  displayedValueProviderReference        String?
  displayedValueSourceTimestamp          DateTime?
  eligibilityListingValueAmount          String?
  eligibilityListingValueCurrency        String?
  eligibilityListingValueDecimals        Int?
  eligibilityListingValueSourceTimestamp DateTime?
  snapshot                               FlipInventorySnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, ordinal])
  @@unique([snapshotId, providerAssetReference])
  @@unique([snapshotId, providerListingReference])
  @@index([snapshotId, eligible, ordinal])
}
