generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum DuelMode {
  DIRECT
  OPEN
  HOUSE
}

enum DuelStatus {
  WAITING
  MATCHED
  COMMITTING
  FUNDED
  OPENING
  AWAITING_ASSETS
  SETTLING
  SETTLED
  CANCELLING
  CANCELLED
  REFUNDING
  REFUNDED
  FAILED
}

enum SolanaNetwork {
  DEVNET
}

enum ProviderMode {
  MOCK
  COLLECTOR_CRYPT_SANDBOX
}

enum DuelSide {
  CREATOR
  OPPONENT
}

enum DuelTransactionAction {
  FUND
  CANCEL
  REFUND
  OPEN_PACK
  COMMIT_RESULT
  SETTLE
}

enum DuelTransactionStatus {
  PREPARED
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED
  EXPIRED
}

enum ProductEventName {
  LOBBY_VIEWED
  TIER_SELECTED
  WALLET_CONNECTED
  WALLET_AUTHENTICATED
  DUEL_CREATED
  DUEL_MATCHED
  DUEL_FUNDED
  PACK_REVEAL_STARTED
  PACK_REVEALED
  DUEL_SHARED
  DUEL_REMATCHED
  DUEL_CANCELLED
  DUEL_REFUNDED
  DUEL_SETTLED
  SETTLEMENT_FAILED
  PROVIDER_ERROR
  SOLANA_RPC_ERROR
  UI_ERROR
  MATCHMAKING_WAIT_STARTED
  MATCHMAKING_MATCHED
  MATCHMAKING_ABANDONED
  MATCHMAKING_COMMITMENT_FAILED
  HOUSE_FALLBACK_SELECTED
}

enum ProductEventSource {
  CLIENT
  SERVER
}

enum OperatorAction {
  EMERGENCY_PAUSE
  EMERGENCY_RESUME
}

enum OperatorActorClass {
  INTEGRATION_KEY
}

enum OperatorReasonCode {
  MAINTENANCE
  PROVIDER_DEGRADED
  RPC_DEGRADED
  TREASURY_LIMIT
  SECURITY_INCIDENT
  MANUAL_REVIEW
}

enum MatchmakingTicketRole {
  CREATOR
  OPPONENT
}

enum MatchmakingTicketStatus {
  SEARCHING
  MATCHED
}

model Duel {
  id                  String              @id
  mode                DuelMode
  status              DuelStatus
  network             SolanaNetwork       @default(DEVNET)
  providerMode        ProviderMode        @default(MOCK)
  creatorWallet       String
  opponentWallet      String?
  opponentJoinedAt    DateTime?
  houseOpponent       Boolean             @default(false)
  winnerWallet        String?
  escrowAddress       String?
  packId              String
  packName            String
  packProvider        String
  providerPackId      String?
  stakeAmount         String
  stakeCurrency       String              @default("USDC")
  stakeDecimals       Int                 @default(6)
  valuationPolicyHash String?
  expiresAt           DateTime
  cancellationReason  String?
  version             Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  matchedAt           DateTime?
  fundedAt            DateTime?
  settledAt           DateTime?
  resultHash          String?
  resultReadyAt       DateTime?
  commitmentExpiresAt DateTime?
  events              DuelEvent[]
  transactions        DuelTransaction[]
  packOutcomes        DuelPackOutcome[]
  matchmakingTickets  MatchmakingTicket[]

  @@index([status, expiresAt])
  @@index([mode, status, packId, createdAt])
  @@index([creatorWallet, createdAt])
  @@index([opponentWallet, createdAt])
  @@index([winnerWallet, createdAt])
}

model MatchmakingTicket {
  id                  String                  @id
  wallet              String                  @unique
  duelId              String
  role                MatchmakingTicketRole
  status              MatchmakingTicketStatus
  queueKey            String
  packId              String
  tier                Int
  valuationPolicyHash String
  providerMode        ProviderMode
  regionSegment       String
  riskSegment         String
  commitmentExpiresAt DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  duel                Duel                    @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, role])
  @@index([queueKey, status, createdAt])
  @@index([commitmentExpiresAt, status])
}

model MatchmakingBehavior {
  wallet                 String    @id
  failedCommitments      Int       @default(0)
  failureWindowStartedAt DateTime
  blockedUntil           DateTime?
  updatedAt              DateTime  @updatedAt

  @@index([blockedUntil])
}

model DuelPackOutcome {
  id                   String   @id
  duelId               String
  side                 DuelSide
  provider             String
  providerReference    String
  assetReference       String
  displayName          String
  insuredValueAmount   String
  insuredValueCurrency String   @default("USDC")
  insuredValueDecimals Int      @default(6)
  valuationPolicyHash  String
  resultHash           String
  isMock               Boolean
  openedAt             DateTime
  createdAt            DateTime @default(now())
  duel                 Duel     @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, side])
  @@unique([provider, providerReference])
  @@index([duelId, openedAt])
}

model DuelEvent {
  id          String      @id
  duelId      String
  sequence    Int
  type        String
  actorWallet String?
  fromStatus  DuelStatus?
  toStatus    DuelStatus?
  data        Json?
  createdAt   DateTime    @default(now())
  duel        Duel        @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, sequence])
  @@index([duelId, createdAt])
}

model IdempotencyRecord {
  id          String   @id
  scope       String
  key         String
  requestHash String
  resourceId  String
  statusCode  Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

model DuelTransaction {
  id                              String                @id
  duelId                          String
  action                          DuelTransactionAction
  status                          DuelTransactionStatus @default(PREPARED)
  network                         SolanaNetwork         @default(DEVNET)
  wallet                          String
  signature                       String?               @unique
  idempotencyKey                  String?               @unique
  submissionIdempotencyKey        String?               @unique
  serializedTransaction           String?
  recentBlockhash                 String?
  lastValidBlockHeight            BigInt?
  expectedSigner                  String?
  expectedProgramId               String?
  expectedMessageHash             String?
  expectedAccounts                Json?
  expectedInstructionDataHash     String?
  expectedInstructionAccounts     Json?
  allowMultipleInstructionMatches Boolean               @default(false)
  expectedFromStatus              DuelStatus?
  expectedToStatus                DuelStatus?
  providerReference               String?
  errorCode                       String?
  errorMessage                    String?
  metadata                        Json?
  confirmationStatus              String?
  checkAttempts                   Int                   @default(0)
  lastCheckedAt                   DateTime?
  nextCheckAt                     DateTime?
  stuckAt                         DateTime?
  submittedAt                     DateTime?
  confirmedAt                     DateTime?
  finalizedAt                     DateTime?
  expiresAt                       DateTime?
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
  duel                            Duel                  @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, wallet, action])
  @@index([duelId, createdAt])
  @@index([duelId, wallet, action])
  @@index([status, updatedAt])
  @@index([status, nextCheckAt])
}

model WalletAuthChallenge {
  id         String    @id
  wallet     String
  nonceHash  String    @unique
  domain     String
  uri        String
  chain      String
  message    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([wallet, expiresAt])
  @@index([expiresAt, consumedAt])
}

model WalletSession {
  id         String    @id
  wallet     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  @@index([wallet, expiresAt])
  @@index([expiresAt, revokedAt])
}

model ProductEvent {
  id        String             @id
  name      ProductEventName
  source    ProductEventSource
  sessionId String?
  duelId    String?
  status    DuelStatus?
  tier      Int?
  mode      DuelMode?
  createdAt DateTime           @default(now())

  @@index([createdAt, name])
  @@index([sessionId, createdAt])
  @@index([duelId, createdAt])
}

model RuntimeControl {
  key        String              @id
  paused     Boolean             @default(false)
  reasonCode OperatorReasonCode?
  actorClass OperatorActorClass  @default(INTEGRATION_KEY)
  actorLabel String              @default("integration-key")
  version    Int                 @default(1)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model OperatorAuditEvent {
  id             String             @id
  action         OperatorAction
  actorClass     OperatorActorClass
  actorLabel     String
  reasonCode     OperatorReasonCode
  previousPaused Boolean
  nextPaused     Boolean
  createdAt      DateTime           @default(now())

  @@index([createdAt, id])
}
