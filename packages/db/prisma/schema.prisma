/// Fixture-only durable Crash/Card Streak round. No production route creates
/// these rows: every round is bound to reviewed synthetic architecture,
/// calculator, state-machine, wallet, and rules references.
model CrashRound {
  id                    String                       @id
  activationMode        String                       @default("fixture-only")
  status                CrashRoundStatus             @default(ACTIVE)
  stage                 Int                          @default(1)
  version               Int                          @default(1)
  architectureVersion   String
  stateMachineVersion   String
  stateMachineRulesHash String
  calculatorVersion     String
  rulesVersion          String
  rulesHash             String
  riskRulesVersion      String?
  riskRulesHash         String?
  riskStartedAt         DateTime?
  riskExpiresAt         DateTime?
  playerWalletReference String
  potAmount             String
  potCurrency           String                       @default("USDC")
  potDecimals           Int                          @default(6)
  decisionDeadline      DateTime?
  defaultAction         CrashDecision
  terminalReason        String?
  terminalAt            DateTime?
  settlementStatus      CrashSettlementStatus        @default(NOT_REQUIRED)
  settlementReceiptHash String?
  settledAt             DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  transitions           CrashTransition[]
  custodyIntents        CrashCustodyMovementIntent[]
  houseReservation      HouseTreasuryReservation?
  houseLedgerEntries    HouseTreasuryLedgerEntry[]
  settlement            CrashSettlement?
  houseInventory        HouseInventoryAsset[]

  @@index([status, decisionDeadline])
  @@index([settlementStatus, updatedAt])
  @@index([playerWalletReference, createdAt])
  @@index([rulesHash, createdAt])
}

/// Non-signable fixture/devnet movement intent. It proves the canonical round,
/// stage, owner, rule binding, and approved custody recipient were checked
/// before any signing boundary can be reached.
model CrashCustodyMovementIntent {
  id                    String                    @id
  roundId               String
  stage                 Int
  expectedVersion       Int
  idempotencyKey        String
  requestHash           String
  assetReference        String
  sourceWalletReference String
  playerWalletReference String
  requestedRecipient    String
  approvedRecipient     String?
  network               String                    @default("solana-devnet")
  activationMode        String                    @default("fixture-only")
  policyVersion         String?
  policyHash            String?
  architectureVersion   String
  stateMachineVersion   String
  stateMachineRulesHash String
  calculatorVersion     String
  rulesVersion          String
  rulesHash             String
  status                CrashCustodyIntentStatus
  signingStatus         CrashCustodySigningStatus @default(NOT_STARTED)
  recoveryReason        String?
  createdAt             DateTime                  @default(now())
  round                 CrashRound                @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, idempotencyKey])
  @@index([roundId, stage, assetReference])
  @@index([status, createdAt])
}

/// Append-only evidence for one accepted Crash transition. The round version
/// and sequence are identical, making durable replay and audit ordering
/// independent of wall-clock timestamp precision.
model CrashTransition {
  id                    String              @id
  roundId               String
  sequence              Int
  transitionKey         String
  requestHash           String
  kind                  CrashTransitionKind
  decision              CrashDecision?
  fromStatus            CrashRoundStatus?
  toStatus              CrashRoundStatus
  fromStage             Int?
  toStage               Int
  scheduledDeadline     DateTime?
  payment               Json?
  outcome               Json?
  valueChange           Json?
  settlement            Json?
  riskEvidence          Json?
  terminalReason        String?
  architectureVersion   String
  stateMachineVersion   String
  stateMachineRulesHash String
  calculatorVersion     String
  rulesVersion          String
  rulesHash             String
  createdAt             DateTime            @default(now())
  round                 CrashRound          @relation(fields: [roundId], references: [id], onDelete: Cascade)
  terminalSettlement    CrashSettlement?

  @@unique([roundId, sequence])
  @@unique([roundId, transitionKey])
  @@index([roundId, createdAt])
  @@index([rulesHash, createdAt])
}

/// One immutable-plan, resumable fixture settlement for a terminal Crash round.
/// Provider operations are keyed independently so an ambiguous response is
/// reconciled by the same request key rather than signed a second time.
model CrashSettlement {
  id                      String                     @id
  roundId                 String                     @unique
  terminalTransitionId    String                     @unique
  idempotencyKey          String
  requestHash             String
  kind                    CrashSettlementKind
  status                  CrashSettlementStatus      @default(PENDING)
  activationMode          String                     @default("fixture-only")
  network                 String                     @default("solana-devnet")
  playerWalletReference   String
  custodyRecipient        String
  custodyPolicyVersion    String
  custodyPolicyHash       String
  inventoryRecipient      String
  settlementPolicyVersion String
  settlementPolicyHash    String
  inventoryPolicyVersion  String
  inventoryPolicyHash     String
  architectureVersion     String
  stateMachineVersion     String
  stateMachineRulesHash   String
  calculatorVersion       String
  rulesVersion            String
  rulesHash               String
  riskRulesVersion        String
  riskRulesHash           String
  expectedOperationCount  Int
  finalizedOperationCount Int                        @default(0)
  recoveryReason          String?
  receipt                 Json?
  receiptHash             String?
  settledAt               DateTime?
  leaseOwner              String?
  leaseExpiresAt          DateTime?
  version                 Int                        @default(1)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  round                   CrashRound                 @relation(fields: [roundId], references: [id], onDelete: Restrict)
  terminalTransition      CrashTransition            @relation(fields: [terminalTransitionId], references: [id], onDelete: Restrict)
  operations              CrashSettlementOperation[]

  @@unique([roundId, idempotencyKey])
  @@index([status, leaseExpiresAt, updatedAt])
}

/// Mutable recovery state for one deterministic provider side effect. The
/// request hash and provider request key are immutable after insert.
model CrashSettlementOperation {
  id                   String                         @id
  settlementId         String
  sequence             Int
  operationKey         String
  providerRequestKey   String                         @unique
  requestHash          String
  kind                 CrashSettlementOperationKind
  status               CrashSettlementOperationStatus @default(PREPARED)
  recoveryMode         CrashSettlementRecoveryMode    @default(NONE)
  assetReference       String
  sourceReference      String
  destinationReference String
  amount               String
  currency             String                         @default("USDC")
  decimals             Int                            @default(6)
  stage                Int?
  providerSignature    String?                        @unique
  providerResultHash   String?
  providerEvidence     Json?
  failureCode          String?
  submissionCount      Int                            @default(0)
  lastAttemptedAt      DateTime?
  finalizedAt          DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  settlement           CrashSettlement                @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  houseInventoryAsset  HouseInventoryAsset?

  @@unique([settlementId, sequence])
  @@unique([settlementId, operationKey])
  @@index([status, recoveryMode, updatedAt])
}

model Duel {
  id                  String                     @id
  mode                DuelMode
  status              DuelStatus
  network             SolanaNetwork              @default(DEVNET)
  providerMode        ProviderMode               @default(MOCK)
  creatorWallet       String
  opponentWallet      String?
  opponentJoinedAt    DateTime?
  houseOpponent       Boolean                    @default(false)
  winnerWallet        String?
  escrowAddress       String?
  packId              String
  packName            String
  packProvider        String
  providerPackId      String?
  stakeAmount         String
  stakeCurrency       String                     @default("USDC")
  stakeDecimals       Int                        @default(6)
  valuationPolicyHash String?
  expiresAt           DateTime
  cancellationReason  String?
  version             Int                        @default(1)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  matchedAt           DateTime?
  fundedAt            DateTime?
  settledAt           DateTime?
  resultHash          String?
  resultReadyAt       DateTime?
  rgsCommitmentHash   String?
  rgsConfigHash       String?
  rgsRulesHash        String?
  commitmentExpiresAt DateTime?
  events              DuelEvent[]
  transactions        DuelTransaction[]
  packOutcomes        DuelPackOutcome[]
  matchmakingTickets  MatchmakingTicket[]
  houseReservation    HouseTreasuryReservation?
  houseInventory      HouseInventoryAsset[]
  houseLedgerEntries  HouseTreasuryLedgerEntry[]
  devnetPackSnapshots DevnetPackSnapshot[]
  providerOperations  DuelProviderOperation[]

  @@index([status, expiresAt])
  @@index([mode, status, packId, createdAt])
  @@index([creatorWallet, createdAt])
  @@index([opponentWallet, createdAt])
  @@index([status, settledAt, id])
  @@index([winnerWallet, createdAt])
}

