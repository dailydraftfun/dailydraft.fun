generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum DuelMode {
  DIRECT
  OPEN
  HOUSE
}

enum DuelStatus {
  WAITING
  MATCHED
  COMMITTING
  FUNDED
  OPENING
  AWAITING_ASSETS
  SETTLING
  SETTLED
  CANCELLING
  CANCELLED
  REFUNDING
  REFUNDED
  FAILED
}

enum SolanaNetwork {
  DEVNET
}

enum ProviderMode {
  MOCK
  DAILYDRAFT_DEVNET
  COLLECTOR_CRYPT_SANDBOX
}

enum DuelSide {
  CREATOR
  OPPONENT
}

enum DuelProviderOperationStatus {
  REQUESTED
  GENERATED
  OPENING
  OPENED
  RECOVERY_REQUIRED
}

enum DuelTransactionAction {
  FUND
  CANCEL
  REFUND
  OPEN_PACK
  COMMIT_RESULT
  SETTLE
}

enum DuelTransactionStatus {
  PREPARED
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED
  EXPIRED
}

enum ProductEventName {
  LOBBY_VIEWED
  TIER_SELECTED
  WALLET_CONNECTED
  WALLET_AUTHENTICATED
  DUEL_CREATED
  DUEL_MATCHED
  DUEL_FUNDED
  PACK_REVEAL_STARTED
  PACK_REVEALED
  DUEL_SHARED
  DUEL_REMATCHED
  DUEL_CANCELLED
  DUEL_REFUNDED
  DUEL_SETTLED
  SETTLEMENT_FAILED
  PROVIDER_ERROR
  SOLANA_RPC_ERROR
  UI_ERROR
  MATCHMAKING_WAIT_STARTED
  MATCHMAKING_MATCHED
  MATCHMAKING_ABANDONED
  MATCHMAKING_COMMITMENT_FAILED
  HOUSE_FALLBACK_SELECTED
}

enum ProductEventSource {
  CLIENT
  SERVER
}

enum OperatorAction {
  EMERGENCY_PAUSE
  EMERGENCY_RESUME
}

enum OperatorActorClass {
  INTEGRATION_KEY
}

enum OperatorReasonCode {
  MAINTENANCE
  PROVIDER_DEGRADED
  RPC_DEGRADED
  TREASURY_LIMIT
  SECURITY_INCIDENT
  MANUAL_REVIEW
}

enum MatchmakingTicketRole {
  CREATOR
  OPPONENT
}

enum MatchmakingTicketStatus {
  SEARCHING
  MATCHED
}

enum HouseTreasuryReservationStatus {
  RESERVED
  FUNDED
  SETTLEMENT_PENDING
  RECOVERY_REQUIRED
  RELEASED
  SETTLED
}

enum HouseTreasuryLedgerType {
  RESERVATION_CREATED
  RESERVATION_RELEASED
  HOUSE_FUNDING_COMMITTED
  PLAYER_WIN_LOSS
  HOUSE_PACK_COST
  HOUSE_WIN_INVENTORY
  INVENTORY_DISPOSITION_SET
  INVENTORY_DISPOSED
  RECONCILIATION_ALERT
}

enum HouseInventoryDisposition {
  HOLD
  BUYBACK
  LIST
  PROMOTION
  MANUAL_REVIEW
}

enum HouseInventoryStatus {
  HELD
  LISTED
  DISPOSED
  RECONCILIATION_REQUIRED
}

enum HouseInventoryListingState {
  UNLISTED
  LISTED
  SOLD
  DELISTED
}

enum FlipInventoryExclusionReason {
  EXPLICIT_EXCLUSION
  COLLECTION_NOT_ALLOWED
  GRADER_NOT_ALLOWED
  INVENTORY_STALE
  INVENTORY_FROM_FUTURE
  LIQUIDITY_BELOW_MINIMUM
  VALUE_UNAVAILABLE
  VALUE_STALE
  VALUE_FROM_FUTURE
  VALUE_BELOW_MINIMUM
  VALUE_ABOVE_MAXIMUM
  MAXIMUM_ITEM_COUNT
  MAXIMUM_EXPOSURE
}

enum GachaSport {
  FOOTBALL
  SOCCER
  BASEBALL
  BASKETBALL
}

enum GachaRipStatus {
  SELECTED
  REVEALED
  ACQUIRED
  SETTLED
  FAILED
}

enum GachaRipPaymentStatus {
  PENDING
  VERIFIED
  CONSUMED
  EXPIRED
}

enum GachaInventoryExclusionReason {
  MISSING_INSURED_VALUE
  MISSING_ASSET_REFERENCE
  MISSING_VALUATION_SOURCE
  STALE_VALUATION
  FUTURE_VALUATION
  POOL_CLOSED
  TIER_DISABLED
  NOT_VAULTED
  UNGRADED
  SPORT_MISMATCH
  DUPLICATE_ASSET
  MAXIMUM_ITEM_COUNT
}

model Duel {
  id                  String                     @id
  mode                DuelMode
  status              DuelStatus
  network             SolanaNetwork              @default(DEVNET)
  providerMode        ProviderMode               @default(MOCK)
  creatorWallet       String
  opponentWallet      String?
  opponentJoinedAt    DateTime?
  houseOpponent       Boolean                    @default(false)
  winnerWallet        String?
  escrowAddress       String?
  packId              String
  packName            String
  packProvider        String
  providerPackId      String?
  stakeAmount         String
  stakeCurrency       String                     @default("USDC")
  stakeDecimals       Int                        @default(6)
  valuationPolicyHash String?
  expiresAt           DateTime
  cancellationReason  String?
  version             Int                        @default(1)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  matchedAt           DateTime?
  fundedAt            DateTime?
  settledAt           DateTime?
  resultHash          String?
  resultReadyAt       DateTime?
  commitmentExpiresAt DateTime?
  events              DuelEvent[]
  transactions        DuelTransaction[]
  packOutcomes        DuelPackOutcome[]
  matchmakingTickets  MatchmakingTicket[]
  houseReservation    HouseTreasuryReservation?
  houseInventory      HouseInventoryAsset[]
  houseLedgerEntries  HouseTreasuryLedgerEntry[]
  devnetPackSnapshots DevnetPackSnapshot[]
  providerOperations  DuelProviderOperation[]

  @@index([status, expiresAt])
  @@index([mode, status, packId, createdAt])
  @@index([creatorWallet, createdAt])
  @@index([opponentWallet, createdAt])
  @@index([status, settledAt, id])
  @@index([winnerWallet, createdAt])
}

model DuelProviderOperation {
  id                     String                      @id
  duelId                 String
  side                   DuelSide
  provider               String
  providerPackId         String
  recipientWallet        String
  generateIdempotencyKey String
  openIdempotencyKey     String
  status                 DuelProviderOperationStatus @default(REQUESTED)
  providerReference      String?
  rawPayload             String?
  payloadHash            String?
  signature              String?
  signatureAlgorithm     String?
  signingKeyReference    String?
  assetReference         String?
  resultHash             String?
  normalizedOutcome      Json?
  errorCode              String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  duel                   Duel                        @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, side])
  @@unique([provider, providerReference])
  @@index([duelId, status])
}

model DevnetPackSnapshot {
  providerReference     String    @id
  duelId                String
  side                  DuelSide
  providerPackId        String
  pokemonCardId         String
  displayName           String
  imageUrl              String
  insuredValueAmount    String
  priceVariant          String
  priceUpdatedAt        String
  sourceTimestamp       DateTime
  depositLeaseOwner     String?
  depositLeaseExpiresAt DateTime?
  depositSignature      String?
  assetReference        String?
  openedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  duel                  Duel      @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, side])
  @@index([pokemonCardId, createdAt])
}

model MatchmakingTicket {
  id                  String                  @id
  wallet              String                  @unique
  duelId              String
  role                MatchmakingTicketRole
  status              MatchmakingTicketStatus
  queueKey            String
  packId              String
  tier                Int
  valuationPolicyHash String
  providerMode        ProviderMode
  regionSegment       String
  riskSegment         String
  commitmentExpiresAt DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  duel                Duel                    @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, role])
  @@index([queueKey, status, createdAt])
  @@index([commitmentExpiresAt, status])
}

model MatchmakingBehavior {
  wallet                 String    @id
  failedCommitments      Int       @default(0)
  failureWindowStartedAt DateTime
  blockedUntil           DateTime?
  updatedAt              DateTime  @updatedAt

  @@index([blockedUntil])
}

model DuelPackOutcome {
  id                       String               @id
  duelId                   String
  side                     DuelSide
  provider                 String
  providerReference        String
  assetReference           String
  displayName              String
  imageUrl                 String?
  valuationSourceReference String?
  insuredValueAmount       String
  insuredValueCurrency     String               @default("USDC")
  insuredValueDecimals     Int                  @default(6)
  sourceTimestamp          DateTime?
  poolVersion              String?
  valuationPolicyHash      String
  resultHash               String
  isMock                   Boolean
  openedAt                 DateTime
  createdAt                DateTime             @default(now())
  duel                     Duel                 @relation(fields: [duelId], references: [id], onDelete: Cascade)
  houseInventoryAsset      HouseInventoryAsset?

  @@unique([duelId, side])
  @@unique([provider, providerReference])
  @@index([duelId, openedAt])
}

model DuelEvent {
  id          String      @id
  duelId      String
  sequence    Int
  type        String
  actorWallet String?
  fromStatus  DuelStatus?
  toStatus    DuelStatus?
  data        Json?
  createdAt   DateTime    @default(now())
  duel        Duel        @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, sequence])
  @@index([duelId, createdAt])
}

model IdempotencyRecord {
  id          String   @id
  scope       String
  key         String
  requestHash String
  resourceId  String
  statusCode  Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

model DuelTransaction {
  id                              String                @id
  duelId                          String
  action                          DuelTransactionAction
  status                          DuelTransactionStatus @default(PREPARED)
  network                         SolanaNetwork         @default(DEVNET)
  wallet                          String
  signature                       String?               @unique
  idempotencyKey                  String?               @unique
  submissionIdempotencyKey        String?               @unique
  serializedTransaction           String?
  recentBlockhash                 String?
  lastValidBlockHeight            BigInt?
  expectedSigner                  String?
  expectedProgramId               String?
  expectedMessageHash             String?
  expectedAccounts                Json?
  expectedInstructionDataHash     String?
  expectedInstructionAccounts     Json?
  allowMultipleInstructionMatches Boolean               @default(false)
  expectedFromStatus              DuelStatus?
  expectedToStatus                DuelStatus?
  providerReference               String?
  errorCode                       String?
  errorMessage                    String?
  metadata                        Json?
  confirmationStatus              String?
  checkAttempts                   Int                   @default(0)
  lastCheckedAt                   DateTime?
  nextCheckAt                     DateTime?
  stuckAt                         DateTime?
  submittedAt                     DateTime?
  recoveredAt                     DateTime?
  lastRecoveryCheckedAt           DateTime?
  lastRecoveryCheckedBlockHeight  BigInt?
  nextRecoveryCheckAt             DateTime?
  recoveryCheckAttempts           Int                   @default(0)
  recoveryCandidateAt             DateTime?
  recoveryCandidateSignature      String?
  recoveryAlertCode               String?
  confirmedAt                     DateTime?
  finalizedAt                     DateTime?
  expiresAt                       DateTime?
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
  duel                            Duel                  @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@index([duelId, createdAt])
  @@index([duelId, wallet, action])
  @@index([status, updatedAt])
  @@index([status, nextCheckAt])
  @@index([status, nextRecoveryCheckAt, createdAt])
  @@index([recoveryCandidateAt])
}

model WalletAuthChallenge {
  id         String    @id
  wallet     String
  nonceHash  String    @unique
  domain     String
  uri        String
  chain      String
  message    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([wallet, expiresAt])
  @@index([wallet, createdAt])
  @@index([expiresAt, consumedAt])
}

model WalletSession {
  id         String    @id
  wallet     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  @@index([wallet, expiresAt])
  @@index([expiresAt, revokedAt])
}

model ProductEvent {
  id        String             @id
  name      ProductEventName
  source    ProductEventSource
  sessionId String?
  duelId    String?
  status    DuelStatus?
  tier      Int?
  mode      DuelMode?
  createdAt DateTime           @default(now())

  @@index([createdAt, name])
  @@index([sessionId, createdAt])
  @@index([duelId, createdAt])
}

/// Immutable decision evidence recorded before an exposure-creating API operation.
model RealValuePolicyDecision {
  id            String   @id
  capability    String
  runtimeMode   String
  schemaVersion String
  policyVersion String
  policyHash    String
  allowed       Boolean
  denialReason  String?
  evidence      Json
  evaluatedAt   DateTime
  createdAt     DateTime @default(now())

  @@index([capability, evaluatedAt])
  @@index([allowed, evaluatedAt])
  @@index([policyVersion, evaluatedAt])
}

model RuntimeControl {
  key        String              @id
  paused     Boolean             @default(false)
  reasonCode OperatorReasonCode?
  actorClass OperatorActorClass  @default(INTEGRATION_KEY)
  actorLabel String              @default("integration-key")
  version    Int                 @default(1)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model OperatorAuditEvent {
  id             String             @id
  action         OperatorAction
  actorClass     OperatorActorClass
  actorLabel     String
  reasonCode     OperatorReasonCode
  previousPaused Boolean
  nextPaused     Boolean
  createdAt      DateTime           @default(now())

  @@index([createdAt, id])
}

/// One mutable, finalized balance snapshot per network/wallet/mint/token account policy.
/// The service uses the fixed `solana-devnet-usdc` id for the current devnet policy.
model HouseTreasurySnapshot {
  id              String        @id
  network         SolanaNetwork @default(DEVNET)
  wallet          String
  tokenAccount    String
  mint            String
  balanceAmount   String
  balanceDecimals Int
  delegate        String
  delegatedAmount String
  verifiedAt      DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([network, wallet, mint, tokenAccount])
}

/// Current admission state for each configured house tier. The reservation engine remains the
/// enforcement point; this row makes its latest fail-closed decision and recovery boundary
/// observable without affecting already-funded lifecycle processing.
model HouseTierAdmissionState {
  tier             Int      @id
  disabled         Boolean  @default(false)
  reason           String?
  reenableBoundary String?
  evaluatedAt      DateTime
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HouseTreasuryReservation {
  id               String                         @id
  duelId           String                         @unique
  playerWallet     String
  tier             Int
  amount           String
  currency         String                         @default("USDC")
  decimals         Int                            @default(6)
  status           HouseTreasuryReservationStatus @default(RESERVED)
  reservedAt       DateTime                       @default(now())
  fundedAt         DateTime?
  releasedAt       DateTime?
  settledAt        DateTime?
  lastReconciledAt DateTime?
  version          Int                            @default(1)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  duel             Duel                           @relation(fields: [duelId], references: [id], onDelete: Restrict)
  ledgerEntries    HouseTreasuryLedgerEntry[]

  @@index([status, tier, reservedAt])
  @@index([status, lastReconciledAt, id])
  @@index([playerWallet, status])
}

model HouseInventoryAsset {
  id                       String                     @id
  duelId                   String
  outcomeId                String                     @unique
  assetReference           String                     @unique
  displayName              String
  acquisitionValueAmount   String
  acquisitionValueCurrency String                     @default("USDC")
  acquisitionValueDecimals Int                        @default(6)
  insuredValueAmount       String
  insuredValueCurrency     String                     @default("USDC")
  insuredValueDecimals     Int                        @default(6)
  listingValueAmount       String?
  listingValueCurrency     String?
  listingValueDecimals     Int?
  buybackValueAmount       String?
  buybackValueCurrency     String?
  buybackValueDecimals     Int?
  displayedValueAmount     String?
  displayedValueCurrency   String?
  displayedValueDecimals   Int?
  buybackEligible          Boolean                    @default(false)
  buybackExpiresAt         DateTime?
  listingState             HouseInventoryListingState @default(UNLISTED)
  custodyWallet            String
  disposition              HouseInventoryDisposition  @default(MANUAL_REVIEW)
  status                   HouseInventoryStatus       @default(HELD)
  realizedAmount           String?
  realizedCurrency         String?
  realizedDecimals         Int?
  disposedAt               DateTime?
  lastReconciledAt         DateTime?
  reconciliationError      String?
  version                  Int                        @default(1)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  duel                     Duel                       @relation(fields: [duelId], references: [id], onDelete: Restrict)
  outcome                  DuelPackOutcome            @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  ledgerEntries            HouseTreasuryLedgerEntry[]

  @@index([status, disposition, createdAt])
  @@index([duelId, createdAt])
  @@index([custodyWallet, status])
}

model HouseTreasuryLedgerEntry {
  id             String                    @id
  idempotencyKey String                    @unique
  duelId         String?
  reservationId  String?
  inventoryId    String?
  type           HouseTreasuryLedgerType
  amount         String
  currency       String                    @default("USDC")
  decimals       Int                       @default(6)
  metadata       Json?
  createdAt      DateTime                  @default(now())
  duel           Duel?                     @relation(fields: [duelId], references: [id], onDelete: Restrict)
  reservation    HouseTreasuryReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  inventory      HouseInventoryAsset?      @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([createdAt, type])
  @@index([duelId, createdAt])
  @@index([inventoryId, createdAt])
}

/// Immutable, fixture-backed eligibility evidence for one reviewed Flip pool.
/// A new content hash creates a new revision; existing revisions are append-only.
model FlipInventorySnapshot {
  id                          String                       @id
  poolKey                     String
  revision                    Int
  schemaVersion               String
  policyVersion               String
  provider                    String
  policyHash                  String
  contentHash                 String
  policy                      Json
  stakeAmount                 String
  stakeCurrency               String                       @default("USDC")
  stakeDecimals               Int                          @default(6)
  minimumValueAmount          String
  maximumValueAmount          String
  minimumLiquidityBasisPoints Int
  minimumEligibleItems        Int
  maximumEligibleItems        Int
  maximumExposureAmount       String
  maximumSourceAgeMs          Int
  maximumFutureSkewMs         Int
  eligibleCount               Int
  excludedCount               Int
  eligibleValueAmount         String
  evaluatedAt                 DateTime
  sealedAt                    DateTime?
  createdAt                   DateTime                     @default(now())
  entries                     FlipInventorySnapshotEntry[]

  @@unique([poolKey, revision])
  @@unique([poolKey, contentHash])
  @@index([poolKey, createdAt])
}

/// One canonical provider candidate and the exact inclusion or exclusion decision.
/// Provider evidence and each value type remain distinct from the normalized pool value.
model FlipInventorySnapshotEntry {
  id                                     String                         @id
  snapshotId                             String
  ordinal                                Int
  eligible                               Boolean
  exclusionReasons                       FlipInventoryExclusionReason[]
  providerAssetReference                 String
  providerListingReference               String
  providerCollectionReference            String
  providerGraderReference                String
  normalizedCollection                   String
  normalizedGrader                       String
  liquidityBasisPoints                   Int
  inventorySourceTimestamp               DateTime
  listingValueAmount                     String?
  listingValueCurrency                   String?
  listingValueDecimals                   Int?
  listingValueProviderReference          String?
  listingValueSourceTimestamp            DateTime?
  insuredValueAmount                     String?
  insuredValueCurrency                   String?
  insuredValueDecimals                   Int?
  insuredValueProviderReference          String?
  insuredValueSourceTimestamp            DateTime?
  buybackValueAmount                     String?
  buybackValueCurrency                   String?
  buybackValueDecimals                   Int?
  buybackValueProviderReference          String?
  buybackValueSourceTimestamp            DateTime?
  displayedValueAmount                   String?
  displayedValueCurrency                 String?
  displayedValueDecimals                 Int?
  displayedValueProviderReference        String?
  displayedValueSourceTimestamp          DateTime?
  eligibilityListingValueAmount          String?
  eligibilityListingValueCurrency        String?
  eligibilityListingValueDecimals        Int?
  eligibilityListingValueSourceTimestamp DateTime?
  snapshot                               FlipInventorySnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, ordinal])
  @@unique([snapshotId, providerAssetReference])
  @@unique([snapshotId, providerListingReference])
  @@index([snapshotId, eligible, ordinal])
}

/// One configured Collector Crypt sports pack machine.
/// Production machines remain inactive until every capability gate passes.
model GachaMachine {
  id                 String                    @id
  machineKey         String                    @unique
  sport              GachaSport
  tierPriceMinor     String
  tierPriceCurrency  String                    @default("USDC")
  tierPriceDecimals  Int                       @default(6)
  displayName        String
  committedPoolSize  Int
  active             Boolean                   @default(false)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  inventorySnapshots GachaInventorySnapshot[]
  oddsCommitments    GachaPullOddsCommitment[]
  payments           GachaRipPayment[]
  rips               GachaRip[]

  @@index([sport, tierPriceMinor, active])
}

/// Immutable eligibility evidence for one Gacha machine pool revision.
/// A new content hash creates a new revision; sealed revisions are append-only.
model GachaInventorySnapshot {
  id                   String                        @id
  poolKey              String
  machineKey           String
  revision             Int
  schemaVersion        String
  policyVersion        String
  provider             String
  policyHash           String
  contentHash          String
  policy               Json
  committedPoolSize    Int
  maximumEligibleItems Int
  maximumSourceAgeMs   Int
  maximumFutureSkewMs  Int
  eligibleCount        Int
  excludedCount        Int
  eligibleValueMinor   String
  evaluatedAt          DateTime
  sealedAt             DateTime?
  createdAt            DateTime                      @default(now())
  machine              GachaMachine                  @relation(fields: [machineKey], references: [machineKey], onDelete: Restrict)
  entries              GachaInventorySnapshotEntry[]

  @@unique([poolKey, revision])
  @@unique([poolKey, contentHash])
  @@index([machineKey, createdAt])
  @@index([contentHash])
}

/// One canonical provider card and its exact Gacha inclusion or exclusion decision.
/// Missing or duplicate asset references remain inspectable exclusion evidence.
model GachaInventorySnapshotEntry {
  id                            String                          @id
  snapshotId                    String
  ordinal                       Int
  eligible                      Boolean
  exclusionReasons              GachaInventoryExclusionReason[]
  providerCardReference         String
  assetReference                String?
  displayName                   String
  sport                         GachaSport
  graded                        Boolean
  graderReference               String?
  vaulted                       Boolean
  poolOpen                      Boolean
  tierEnabled                   Boolean
  insuredValueMinor             String?
  insuredValueCurrency          String?
  insuredValueDecimals          Int?
  insuredValueProviderReference String?
  valuationSourceReference      String?
  valuationTimestamp            DateTime?
  inventorySourceTimestamp      DateTime
  snapshot                      GachaInventorySnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, ordinal])
  @@unique([snapshotId, providerCardReference])
  @@index([snapshotId, eligible, ordinal])
  @@index([assetReference])
}

/// Versioned, hash-locked probability bands committed before a Gacha rip.
/// The snapshot content hash binds the odds to one sealed inventory revision.
model GachaPullOddsCommitment {
  id                    String       @id
  machineKey            String
  oddsKey               String
  version               Int
  schemaVersion         String
  calculatorVersion     String
  rulesHash             String
  snapshotContentHash   String
  probabilityScalePpm   Int          @default(1000000)
  baseProbabilityPpm    Int
  plusProbabilityPpm    Int
  premiumProbabilityPpm Int
  chaseProbabilityPpm   Int
  bandMinimums          Json
  committedAt           DateTime
  sealedAt              DateTime?
  createdAt             DateTime     @default(now())
  machine               GachaMachine @relation(fields: [machineKey], references: [machineKey], onDelete: Restrict)
  rips                  GachaRip[]

  @@unique([oddsKey, version])
  @@index([machineKey, committedAt])
  @@index([snapshotContentHash])
}

/// A server-committed random seed reserved for exactly one Gacha rip. The raw
/// serverSeed is secret until the rip it backs reaches a terminal state, at
/// which point it is revealed so the roll can be independently recomputed
/// and checked against the previously published serverSeedHash.
model GachaRipSeedCommitment {
  id              String    @id
  machineKey      String
  serverSeed      String
  serverSeedHash  String
  consumedByRipId String?   @unique
  committedAt     DateTime
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  consumedByRip   GachaRip? @relation(fields: [consumedByRipId], references: [id], onDelete: Restrict)

  @@index([machineKey, committedAt])
  @@index([expiresAt])
}

/// One Gacha rip with reveal, ownership acquisition, and settlement recorded separately.
///
/// selectedAssetReference is cleared to null when a rip FAILs (its asset returns to
/// the eligible pool for the next rip) so the (snapshotContentHash,
/// selectedAssetReference) unique index only ever covers assets that are actually
/// claimed. failedAssetReference preserves an audit trail of what a FAILED rip had
/// selected before the asset was released.
model GachaRip {
  id                     String                  @id
  machineKey             String
  oddsCommitmentId       String
  status                 GachaRipStatus
  snapshotContentHash    String
  oddsRulesHash          String
  seedCommitmentHash     String
  selectedAssetReference String?
  failedAssetReference   String?
  acquisitionReference   String?
  settlementReference    String?
  insuredValueMinor      String
  insuredValueCurrency   String                  @default("USDC")
  insuredValueDecimals   Int                     @default(6)
  selectedAt             DateTime
  revealedAt             DateTime?
  acquiredAt             DateTime?
  settledAt              DateTime?
  failedAt               DateTime?
  failureReason          String?
  idempotencyKey         String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  machine                GachaMachine            @relation(fields: [machineKey], references: [machineKey], onDelete: Restrict)
  oddsCommitment         GachaPullOddsCommitment @relation(fields: [oddsCommitmentId], references: [id], onDelete: Restrict)
  payment                GachaRipPayment?
  seedCommitment         GachaRipSeedCommitment?

  @@unique([snapshotContentHash, selectedAssetReference])
  @@unique([machineKey, idempotencyKey])
  @@index([machineKey, createdAt])
  @@index([status, updatedAt])
  @@index([snapshotContentHash])
  @@index([oddsRulesHash])
}

/// A player-funded SPL transfer that pays for exactly one Gacha rip.
///
/// A rip is single-player, so unlike a duel there is no escrow instruction the
/// payment can be bound to. Instead the intent is issued first with a memoNonce
/// the payer must echo inside the signed transaction; verification then binds
/// the landed signature to this row. Both the signature and consumedByRipId are
/// unique, so the database itself refuses to let one payment fund two rips or
/// one transfer satisfy two intents, even under concurrent requests.
model GachaRipPayment {
  id                      String                @id
  machineKey              String
  status                  GachaRipPaymentStatus @default(PENDING)
  network                 SolanaNetwork         @default(DEVNET)
  payerWallet             String
  destinationTokenAccount String
  mint                    String
  amountMinor             String
  amountCurrency          String                @default("USDC")
  amountDecimals          Int                   @default(6)
  memoNonce               String                @unique
  signature               String?               @unique
  /// False when the payer used plain SPL `transfer`, which omits the mint. The
  /// destination token account's mint is resolved out of band before the intent
  /// is issued, so the transfer is still bound to one mint either way.
  mintVerifiedOnChain     Boolean               @default(false)
  consumedByRipId         String?               @unique
  verifiedAt              DateTime?
  consumedAt              DateTime?
  expiresAt               DateTime
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  consumedByRip           GachaRip?             @relation(fields: [consumedByRipId], references: [id], onDelete: Restrict)
  machine                 GachaMachine          @relation(fields: [machineKey], references: [machineKey], onDelete: Restrict)

  @@index([machineKey, createdAt])
  @@index([status, expiresAt])
  @@index([payerWallet, createdAt])
}

// Fantasy Tournaments foundation (sport.fun model on Solana, sourced from
// Collector Crypt sports packs). Data model + module skeleton only; the loop
// stays gated until the oracle feed, kickoff snapshot, and payout math are
// approved. No live entries are accepted from these tables yet.

enum FantasySport {
  SOCCER
  FOOTBALL
  BASEBALL
  BASKETBALL
}

enum FantasyPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum FantasyTournamentStatus {
  DRAFT
  SCHEDULED
  LOCKED
  SCORING
  SETTLED
  CANCELLED
}

enum FantasyMatchResultStatus {
  PENDING
  CONFIRMED
  VOIDED
}

// A player identity mapped to a Collector Crypt sports-card cohort. "Shares" are
// ripped/vaulted graded cards attributed to this identity, not AMM units.
model FantasyPlayer {
  id                      String                   @id
  sport                   FantasySport
  position                FantasyPosition
  collectorCryptPlayerRef String                   @unique
  displayName             String
  teamReference           String?
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  holdings                FantasyPlayerHolding[]
  entries                 FantasyTournamentEntry[]

  @@index([sport, position])
  @@index([active, sport])
}

// A wallet's custody of graded cards attributed to a player. `shares` is the
// count of eligible cards under the referenced custody record.
model FantasyPlayerHolding {
  id               String                   @id
  walletAddress    String
  playerId         String
  shares           Int
  custodyReference String                   @unique
  acquiredAt       DateTime
  releasedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  player           FantasyPlayer            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  entries          FantasyTournamentEntry[]

  @@unique([walletAddress, playerId, custodyReference])
  @@index([playerId, walletAddress])
  @@index([walletAddress])
}

// A scored window for a sport. Scoring/payout rule identities are committed on
// the tournament so results and allocations are reproducible against a hash.
model FantasyTournament {
  id                String                    @id
  sport             FantasySport
  status            FantasyTournamentStatus   @default(DRAFT)
  title             String
  opensAt           DateTime
  locksAt           DateTime
  settlesAt         DateTime
  prizePoolAmount   String
  prizePoolCurrency String                    @default("USDC")
  prizePoolDecimals Int                       @default(6)
  scoringVersion    String
  scoringRulesHash  String
  payoutVersion     String
  payoutRulesHash   String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  entries           FantasyTournamentEntry[]
  snapshots         FantasyKickoffSnapshot[]
  matchResults      FantasyMatchResult[]
  playerScores      FantasyPlayerScore[]
  payoutAllocations FantasyPayoutAllocation[]

  @@index([sport, status, locksAt])
  @@index([status, settlesAt])
}

// A holding auto-entered into a tournament. One entry per holding per
// tournament; `shares`/`playerId` are denormalized from the holding at enrol.
model FantasyTournamentEntry {
  id            String               @id
  tournamentId  String
  holdingId     String
  walletAddress String
  playerId      String
  shares        Int
  enrolledAt    DateTime
  createdAt     DateTime             @default(now())
  tournament    FantasyTournament    @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  holding       FantasyPlayerHolding @relation(fields: [holdingId], references: [id], onDelete: Restrict)
  player        FantasyPlayer        @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, holdingId])
  @@index([tournamentId, playerId])
  @@index([walletAddress])
}

// The sealed kickoff lock for a tournament: per-player eligible shares frozen at
// match start. Immutable + revisioned, mirroring the flip inventory snapshot.
model FantasyKickoffSnapshot {
  id                 String                        @id
  tournamentId       String
  revision           Int
  schemaVersion      String
  policyVersion      String
  policyHash         String
  contentHash        String
  policy             Json
  eligibleShareTotal String
  entryCount         Int
  playerCount        Int
  kickoffAt          DateTime
  evaluatedAt        DateTime
  sealedAt           DateTime?
  createdAt          DateTime                      @default(now())
  tournament         FantasyTournament             @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  entries            FantasyKickoffSnapshotEntry[]

  @@unique([tournamentId, revision])
  @@unique([tournamentId, contentHash])
  @@index([tournamentId, createdAt])
}

// One frozen holding row inside a kickoff snapshot. Player/wallet references are
// denormalized strings so the sealed evidence stays self-contained.
model FantasyKickoffSnapshotEntry {
  id               String                 @id
  snapshotId       String
  ordinal          Int
  walletAddress    String
  playerId         String
  position         FantasyPosition
  eligibleShares   Int
  custodyReference String
  lockedAt         DateTime
  snapshot         FantasyKickoffSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, ordinal])
  @@unique([snapshotId, custodyReference])
  @@index([snapshotId, playerId])
  @@index([snapshotId, position, playerId])
}

// Oracle-ingested match data for a player in a tournament. `statLine` is the raw
// provider payload; scoring consumes it after the result is CONFIRMED.
model FantasyMatchResult {
  id                String                   @id
  tournamentId      String
  playerId          String
  position          FantasyPosition
  oracleMode        String
  providerReference String
  statLine          Json
  status            FantasyMatchResultStatus @default(PENDING)
  observedAt        DateTime
  ingestedAt        DateTime                 @default(now())
  tournament        FantasyTournament        @relation(fields: [tournamentId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, playerId, providerReference])
  @@index([tournamentId, status])
  @@index([tournamentId, playerId])
}

// Versioned scoring output for a player. `totalPoints` is signed milli-point
// minor units (scale 1000); `calculationHash` binds the rule set + inputs.
model FantasyPlayerScore {
  id               String            @id
  tournamentId     String
  playerId         String
  position         FantasyPosition
  scoringVersion   String
  scoringRulesHash String
  calculationHash  String
  totalPoints      String
  pointsScale      Int               @default(1000)
  breakdown        Json
  computedAt       DateTime          @default(now())
  tournament       FantasyTournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, playerId, scoringRulesHash])
  @@index([tournamentId, position])
}

// Versioned position-weighted payout allocation for one holder placement. Sum of
// place basis points across positions is 10000; amounts are USDC minor units.
model FantasyPayoutAllocation {
  id                    String            @id
  tournamentId          String
  payoutVersion         String
  payoutRulesHash       String
  calculationHash       String
  position              FantasyPosition
  place                 Int
  playerId              String
  walletAddress         String
  eligibleShares        Int
  placeBasisPoints      Int
  placeAllocationAmount String
  amount                String
  currency              String            @default("USDC")
  decimals              Int               @default(6)
  settledAt             DateTime?
  createdAt             DateTime          @default(now())
  tournament            FantasyTournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, payoutRulesHash, position, place, walletAddress])
  @@index([tournamentId, position, place])
  @@index([walletAddress])
}
