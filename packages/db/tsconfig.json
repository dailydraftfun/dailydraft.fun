{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "generated/**/*.ts", "prisma.config.ts"]
}
