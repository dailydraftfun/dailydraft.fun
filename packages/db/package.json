{
  "name": "@dailydraft/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bunx --bun prisma generate && bun build src/index.ts --target=node --packages=external --outdir=dist",
    "clean": "rm -rf dist generated",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:drift-check": "bunx --bun prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:validate": "bunx --bun prisma validate",
    "lint": "biome check src/ prisma.config.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run db:generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "@types/pg": "8.15.5",
    "prisma": "7.6.0",
    "typescript": "6.0.3"
  }
}
