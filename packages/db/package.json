{
  "name": "@openpacksduel/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bunx --bun prisma generate",
    "clean": "rm -rf generated",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "lint": "biome check src/ prisma.config.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run db:generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "@types/pg": "8.15.5",
    "prisma": "7.6.0",
    "typescript": "6.0.3"
  }
}
