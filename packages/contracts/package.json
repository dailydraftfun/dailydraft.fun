{
  "name": "@dailydraft/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pull-rarity": {
      "types": "./src/pull-rarity.ts",
      "bun": "./src/pull-rarity.ts",
      "import": "./src/pull-rarity.ts",
      "default": "./dist/pull-rarity.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/pull-rarity.ts --target=bun --outdir=dist",
    "clean": "rm -rf dist",
    "lint": "biome check src/",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "typescript": "6.0.3"
  }
}
