{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60,
      "supportsCancellation": true
    }
  },
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    }
  ]
}
