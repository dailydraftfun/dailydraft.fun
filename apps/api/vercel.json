{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "../../packages/db/**",
      "maxDuration": 300,
      "supportsCancellation": true
    }
  },
  "installCommand": "cd ../.. && bun install --frozen-lockfile && bun --filter @openpacksduel/db db:generate",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/v1/internal/reconciliation/solana",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/v1/internal/reconciliation/treasury",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/v1",
      "destination": "/api?__path=v1"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api?__path=v1/:path*"
    }
  ]
}
