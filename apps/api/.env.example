PORT=3003
NODE_ENV=development
# PostgreSQL connection. Local development uses localhost; production is supplied
# from SSM and points to the private AWS RDS instance reachable from the EC2 host.
DATABASE_URL=postgresql://dailydraft:dailydraft@localhost:5432/dailydraft?schema=public
DAILYDRAFT_API_KEYS=opd_local_replace_me
DAILYDRAFT_APP_URL=http://localhost:3001
DAILYDRAFT_AUTH_DOMAIN=localhost:3001
# Wallet-auth persistence limits. Invalid values fall back to 5 challenges per
# 10-minute wallet window and bounded cleanup batches of 100 rows.
DAILYDRAFT_AUTH_CHALLENGE_LIMIT=5
DAILYDRAFT_AUTH_CHALLENGE_WINDOW_SECONDS=600
DAILYDRAFT_AUTH_CLEANUP_BATCH_SIZE=100
DAILYDRAFT_HOUSE_DEVNET_WALLET=DeWQgPfic3khpn4F7QPu7AHoqyJbKuRk9vKZXdxo12Eu
DAILYDRAFT_DEVNET_FEE_LAMPORTS=1000000
DAILYDRAFT_PROVIDER_MODE=dailydraft-devnet
DAILYDRAFT_NETWORK=solana-devnet
# Real-value admission remains disabled. Devnet and fixture operations use a
# committed non-production policy and still write decision evidence.
DAILYDRAFT_REAL_VALUE_MODE=false
DAILYDRAFT_REAL_VALUE_PRODUCTION_ENABLED=false
# Production promotion requires a separately approved, server-only JSON
# document. Do not populate approval references until their HITL gates close.
# DAILYDRAFT_REAL_VALUE_POLICY_JSON={"schemaVersion":"dailydraft.real-value-policy.v1","policyVersion":"approved-release-version","approvals":{"age":"approved-evidence-reference","disclosure":"approved-evidence-reference","jurisdiction":"approved-evidence-reference","legal":"approved-evidence-reference","limits":"approved-evidence-reference","production":"approved-evidence-reference","sanctions":"approved-evidence-reference"},"capabilities":["duel.create.direct"]}
SOLANA_RPC_URL=https://api.devnet.solana.com
ESCROW_PROGRAM_ID=Co198eFfQcmn1WzZRnHV6jxcSLBDCv1qNfPfiBYdCLfS
ESCROW_PROVIDER_SIGNER=FbbUEM8ixJS4qMXZr64cLUeyPwUamM39ZhHPPT7KdTjJ
ESCROW_FEE_RECIPIENT=DeWQgPfic3khpn4F7QPu7AHoqyJbKuRk9vKZXdxo12Eu
DAILYDRAFT_PROVIDER_ASSET_STANDARD=legacy-spl-nft
# JSON byte array for the devnet-only provider keypair. Store as an encrypted
# SSM SecureString; never expose it to browser code.
# DAILYDRAFT_DEVNET_PROVIDER_KEYPAIR_JSON=
# Optional. Unauthenticated Pokémon TCG API access works at lower documented limits.
# POKEMON_TCG_API_KEY=
# Optional request controls. Defaults: 20-second attempts, one retry, 250 ms backoff.
# POKEMON_TCG_API_TIMEOUT_MS=20000
# POKEMON_TCG_API_RETRIES=1
# POKEMON_TCG_API_RETRY_DELAY_MS=250
CRON_SECRET=replace_with_a_long_random_value
DAILYDRAFT_STUCK_FUNDED_MINUTES=5
DAILYDRAFT_ALLOWED_TIERS=50
DAILYDRAFT_MAX_ACTIVE_DUELS_PER_WALLET=3
DAILYDRAFT_MAX_CONCURRENT_DUELS_PER_TIER=20
DAILYDRAFT_HOUSE_ENABLED=false
# Fixture-only Flip pool snapshots remain disabled unless this is explicitly
# true in local tests or explicit local development. Stake admission also
# requires the exact server-only JSON contract from
# src/providers/fixtures/flip-provider-health-contract.v1.json.
DAILYDRAFT_FLIP_FIXTURE_MODE=false
# DAILYDRAFT_FLIP_PROVIDER_HEALTH_FIXTURE=
# Fixture-only Crash stays disabled unless explicitly enabled in tests, local
# development, or non-production preview. Both JSON documents are complete,
# versioned, hash-committed server-only fixtures; absent/stale/mismatched risk,
# provider, pool, or treasury evidence fails closed.
DAILYDRAFT_CRASH_FIXTURE_MODE=false
# DAILYDRAFT_CRASH_FIXTURE_RULES_JSON=
# DAILYDRAFT_CRASH_FIXTURE_RISK_HEALTH_JSON=
# House play stays disabled until a finalized devnet USDC snapshot and every
# bounded risk/separation-of-duties setting below are configured.
# Hot signer and duel opponent. It must be the bounded SPL delegate, never the token-account owner.
# DAILYDRAFT_HOUSE_DEVNET_FUNDING_SIGNER=
# Cold token-account owner. It must differ from the hot signer and house duel wallet.
# DAILYDRAFT_HOUSE_DEVNET_WITHDRAWAL_AUTHORITY=
# DAILYDRAFT_HOUSE_DEVNET_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# DAILYDRAFT_HOUSE_DEVNET_USDC_TOKEN_ACCOUNT=
# DAILYDRAFT_HOUSE_MAX_TOTAL_EXPOSURE_USDC_MICRO=100000000
# DAILYDRAFT_HOUSE_DAILY_LOSS_LIMIT_USDC_MICRO=50000000
# DAILYDRAFT_HOUSE_MIN_LIQUIDITY_USDC_MICRO=50000000
# DAILYDRAFT_HOUSE_MAX_ACTIVE_PER_WALLET=1
# DAILYDRAFT_HOUSE_MAX_CONCURRENT_PER_TIER=1
# DAILYDRAFT_HOUSE_SNAPSHOT_MAX_AGE_SECONDS=300
# DAILYDRAFT_HOUSE_ALLOWED_DISPOSITIONS=hold,manual_review
# Open matchmaking fails closed until these are populated by a verified upstream policy.
DAILYDRAFT_MATCHMAKING_REGION_SEGMENT=eu
DAILYDRAFT_MATCHMAKING_RISK_SEGMENT=standard
DAILYDRAFT_MATCHMAKING_COMMITMENT_SECONDS=120
DAILYDRAFT_MATCHMAKING_SEARCH_SECONDS=900
DAILYDRAFT_MATCHMAKING_MAX_FAILURES=3
DAILYDRAFT_MATCHMAKING_BLOCK_SECONDS=1800
CORS_ORIGINS=http://localhost:3001

# Reserved server-only partner credential. The live adapter remains disabled
# until Collector Crypt confirms its partner API contract.
# COLLECTOR_CRYPT_API_KEY=
